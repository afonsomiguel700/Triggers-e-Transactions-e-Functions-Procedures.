DROP PROCEDURE IF EXISTS mostrar_situacao;
DROP FUNCTION IF EXISTS calcular_media;

CREATE TABLE IF NOT EXISTS alunos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    idade INT NOT NULL,
    nota1 DECIMAL(5,2) NOT NULL DEFAULT 0,
    nota2 DECIMAL(5,2) NOT NULL DEFAULT 0
);

INSERT INTO alunos (id, nome, idade, nota1, nota2)
VALUES (5, 'Miguel', 20, 6.00, 7.00)
ON DUPLICATE KEY UPDATE
    nome = VALUES(nome),
    idade = VALUES(idade),
    nota1 = VALUES(nota1),
    nota2 = VALUES(nota2);

DELIMITER //

CREATE FUNCTION calcular_media(
    p_nota1 DECIMAL(5,2),
    p_nota2 DECIMAL(5,2)
)
RETURNS DECIMAL(5,2)
DETERMINISTIC
BEGIN
    RETURN (p_nota1 + p_nota2) / 2;
END//

CREATE PROCEDURE mostrar_situacao(IN p_id_aluno INT)
BEGIN
    SELECT
        nome,
        nota1,
        nota2,
        calcular_media(nota1, nota2) AS media,
        CASE
            WHEN calcular_media(nota1, nota2) >= 6 THEN 'Aprovado'
            ELSE 'Reprovado'
        END AS situacao
    FROM alunos
    WHERE id = p_id_aluno;
END//

DELIMITER ;

CALL mostrar_situacao(5);
